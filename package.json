{
  "name": "keeptidy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/render-icons.mjs",
    "render:assets": "bash scripts/render-all.sh",
    "render:docker": "docker build -t keeptidy-render . && docker run --rm -v \"$(pwd)/docs:/app/docs\" keeptidy-render",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render:popup": "remotion render remotion/index.ts Popup out/popup.mp4",
    "remotion:render:options": "remotion render remotion/index.ts Options out/options.mp4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@playwright/test": "^1.49.0",
    "@remotion/cli": "^4.0.190",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "remotion": "^4.0.190",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.0"
  }
}
